# Copy to `.env` and fill in. `.env` is gitignored.

# AeroDataBox — flight status (the "is my flight operating" spine).
# Free tier available via RapidAPI or API.Market (see NOTES.md §3).
AERODATABOX_API_KEY=

# GitHub token (repo scope) for auto-filing source-failure issues. Optional until Phase 3.
# GITHUB_TOKEN=

# Disposable snapshot cache.
DATABASE_URL=sqlite+aiosqlite:///./flysafe.db

# JSON list of allowed frontend origins.
# CORS_ORIGINS=["http://localhost:5173"]
